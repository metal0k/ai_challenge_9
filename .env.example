# Mistral API — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Необязательные дефолты (перекрываются флагами CLI)
MISTRAL_MODEL=mistral-small-latest
# Параметры генерации. Незаданные не отправляются вовсе — Mistral применит
# рекомендованное для модели значение (видно в `advent w01 models`, колонка t°).
# MISTRAL_TEMPERATURE=        # 0..1.5 — потолок API Mistral, не 0..2 от OpenAI
# MISTRAL_TOP_P=              # 0..1
# MISTRAL_MAX_TOKENS=
# MISTRAL_SEED=
# MISTRAL_STOP=               # стоп-строки через запятую
# MISTRAL_REASONING_EFFORT=   # none|minimal|low|medium|high|xhigh

# GitHub — репозиторий курса и token со scope repo
GITHUB_URL=https://github.com/<owner>/<repo>.git
GITHUB_TOKEN=

# OBS Studio — obs-websocket (Инструменты → WebSocket Server Settings)
OBS_WS_HOST=localhost
OBS_WS_PORT=4455
OBS_WS_PASSWORD=

# Яндекс.Диск — OAuth token со scopes cloud_api:disk.read, cloud_api:disk.write
# https://yandex.ru/dev/disk-api/doc/ru/concepts/quickstart
YANDEX_DISK_TOKEN=

# Папка, куда кладутся видео WWDD.mp4 (синхронизируется на Яндекс.Диск)
VIDEO_DIR=<путь к папке внутри синхронизируемого Яндекс.Диска>

# Корень синхронизации Яндекс.Диска (по умолчанию определяется по папке .sync)
# YANDEX_DISK_LOCAL_ROOT=<корень Яндекс.Диска, если автоопределение не сработало>
