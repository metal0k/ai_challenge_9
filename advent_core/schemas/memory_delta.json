{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent memory delta",
  "type": "object",
  "additionalProperties": false,
  "required": ["working", "long_term"],
  "properties": {
    "working": {"$ref": "#/definitions/section"},
    "long_term": {"$ref": "#/definitions/section"}
  },
  "definitions": {
    "set_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "key", "value", "evidence"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "delete_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "key", "evidence"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set", "delete"],
      "properties": {
        "set": {"type": "array", "items": {"$ref": "#/definitions/set_operation"}},
        "delete": {"type": "array", "items": {"$ref": "#/definitions/delete_operation"}}
      }
    }
  }
}
